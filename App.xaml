<Application
    x:Class="Chess.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style x:Key="NavButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="#d8d8d8" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="4,10" /><Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style x:Key="QuietButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="#949494" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="4" /><Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style x:Key="AccountButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="#eeeeee" /><Setter Property="Background" Value="#050505" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style x:Key="AccountTabStyle" TargetType="Button"><Setter Property="Background" Value="#202020" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Height" Value="42" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style x:Key="DialogCloseButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#999999" /><Setter Property="FontSize" Value="24" /><Setter Property="Padding" Value="8,0" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style x:Key="AccountTextBoxStyle" TargetType="TextBox"><Setter Property="Height" Value="44" /><Setter Property="Background" Value="#222222" /><Setter Property="Foreground" Value="#ffffff" /><Setter Property="BorderBrush" Value="#3a3a3a" /><Setter Property="Padding" Value="12,0" /></Style>
    <Style x:Key="AccountPasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="44" /><Setter Property="Background" Value="#222222" /><Setter Property="Foreground" Value="#ffffff" /><Setter Property="BorderBrush" Value="#3a3a3a" /><Setter Property="Padding" Value="12,0" /></Style>
    <Style x:Key="GreenActionButtonStyle" TargetType="Button"><Setter Property="Height" Value="46" /><Setter Property="Background" Value="#86c440" /><Setter Property="Foreground" Value="#071006" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style x:Key="LightSquareStyle" TargetType="Border"><Setter Property="Background" Value="#d9c39d" /></Style>
    <Style x:Key="DarkSquareStyle" TargetType="Border"><Setter Property="Background" Value="#876746" /></Style>
    <Style x:Key="BlackPieceStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Symbol" /><Setter Property="FontSize" Value="62" /><Setter Property="Foreground" Value="#111111" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style x:Key="WhitePieceStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Symbol" /><Setter Property="FontSize" Value="62" /><Setter Property="Foreground" Value="#f5f5f5" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </Application.Resources>
</Application>