<Window
    x:Class="Chess.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootGrid" Background="#050505" Padding="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="194" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="326" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" RowSpacing="26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="LogoHoverSurface" Background="Transparent" CornerRadius="10" Padding="8,8,8,8" Margin="16,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" PointerEntered="LogoHoverSurface_PointerEntered" PointerExited="LogoHoverSurface_PointerExited">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="38" Height="38" CornerRadius="10" Background="#86c440">
            <TextBlock Text="♞" FontFamily="Segoe UI Symbol" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#050505" />
        </Border>
        <TextBlock Text="Chess" FontSize="22" FontWeight="SemiBold" Foreground="#f5f5f5" VerticalAlignment="Center" />
        <TextBlock Text="DEV" FontSize="10" FontWeight="Bold" Foreground="#86c440" VerticalAlignment="Top" Margin="-4,3,0,0" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="1" Spacing="8" Margin="22,18,0,0">
        <Button x:Name="HomeButton" Click="Home_Click" Style="{StaticResource NavButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="⌂" FontSize="21" Margin="0,-2,0,2" VerticalAlignment="Center" /><TextBlock Text="Home" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource NavButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="♟" FontFamily="Segoe UI Symbol" FontSize="20" Margin="0,-2,0,2" VerticalAlignment="Center" /><TextBlock Text="Play" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <StackPanel x:Name="PlaySubmenu" Visibility="Collapsed" Margin="18,0,0,4" Spacing="2">
          <Button x:Name="BotsButton" Click="Bots_Click" Content="Bots" Style="{StaticResource NavButtonStyle}" />
          <Button x:Name="InPersonButton" Click="InPerson_Click" Content="In person" Style="{StaticResource NavButtonStyle}" />
        </StackPanel>
        <Button x:Name="PuzzlesButton" Click="Puzzles_Click" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="♞" FontFamily="Segoe UI Symbol" FontSize="20" Margin="0,-2,0,2" VerticalAlignment="Center" /><TextBlock Text="Puzzles" VerticalAlignment="Center" /></StackPanel></Button>
        <Button x:Name="LearnButton" Click="Learn_Click" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><Canvas Width="24" Height="22" VerticalAlignment="Center"><Line X1="4" Y1="7.5" X2="21" Y2="7.5" Stroke="#b7b7b7" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="1" Y1="14.5" X2="18" Y2="14.5" Stroke="#b7b7b7" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas><TextBlock Text="Learn" VerticalAlignment="Center" /></StackPanel></Button>
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="0">
        <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource QuietButtonStyle}" Margin="22,0,0,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,-2,0,2" VerticalAlignment="Center" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel></Button>
        <StackPanel x:Name="AccountActions" Visibility="Collapsed" Margin="22,8,0,8" Spacing="2">
          <Button x:Name="SwitchAccountButton" Content="Switch Account" Click="SwitchAccount_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Left" />
          <StackPanel x:Name="AccountList" Visibility="Collapsed" Margin="12,0,0,2" Spacing="2" />
        </StackPanel>
        <Button Click="AccountButton_Click" PointerEntered="AccountButton_PointerEntered" PointerExited="AccountButton_PointerExited" Style="{StaticResource AccountButtonStyle}" BorderBrush="#242424" BorderThickness="0,1,0,0" Padding="14,10,10,0" Margin="0,0,0,8" MinHeight="62" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="30" Height="30" CornerRadius="15" Background="#29382a"><TextBlock x:Name="AccountAvatar" Text="G" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#b8da84" FontWeight="Bold" /></Border><StackPanel><TextBlock x:Name="AccountNameText" Text="Guest" Foreground="#eeeeee" /><TextBlock x:Name="AccountStatusText" Text="Create a local account" FontSize="11" Foreground="#888888" /></StackPanel></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer x:Name="HomeContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="28,8,28,8" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="18" Width="{Binding ActualWidth, ElementName=HomeContent}" HorizontalAlignment="Left">
        <Grid>
          <StackPanel>
            <TextBlock x:Name="WelcomeMessageText" Foreground="#f2f2f2" FontSize="29" FontWeight="SemiBold" />
            <TextBlock Text="What would you like to do today?" Foreground="#8e8e8e" FontSize="14" Margin="0,5,0,0" />
          </StackPanel>
          <TextBlock Text="Chess v1.0.2-dev.6" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666666" FontSize="12" />
        </Grid>

        <Border Background="#171b17" BorderBrush="#303a30" BorderThickness="1" CornerRadius="10" Padding="20">
          <Grid ColumnSpacing="22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="10">
              <TextBlock Text="Play locally" Foreground="#f2f2f2" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="Practice against the engine on this computer." Foreground="#9a9a9a" FontSize="13" />
              <Button Click="Bots_Click" Content="Choose a bot" Style="{StaticResource GreenActionButtonStyle}" HorizontalAlignment="Left" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="QUICK TIME CONTROL" Foreground="#707070" FontSize="10" FontWeight="Bold" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="BlitzButton" Click="TimeControl_Click" Tag="Blitz" Background="#252b25" BorderBrush="#86c440" BorderThickness="1" CornerRadius="7" Padding="12,10" HorizontalAlignment="Stretch"><StackPanel><TextBlock Text="5 min" Foreground="#eeeeee" FontSize="15" HorizontalAlignment="Center" /><TextBlock Text="Blitz" Foreground="#8e8e8e" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="RapidButton" Grid.Column="1" Click="TimeControl_Click" Tag="Rapid" Background="#222222" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="12,10" HorizontalAlignment="Stretch"><StackPanel><TextBlock Text="10 min" Foreground="#eeeeee" FontSize="15" HorizontalAlignment="Center" /><TextBlock Text="Rapid" Foreground="#8e8e8e" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
                <Button x:Name="BulletButton" Grid.Column="2" Click="TimeControl_Click" Tag="Bullet" Background="#222222" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="12,10" HorizontalAlignment="Stretch"><StackPanel><TextBlock Text="1 min" Foreground="#eeeeee" FontSize="15" HorizontalAlignment="Center" /><TextBlock Text="Bullet" Foreground="#8e8e8e" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button Click="Puzzles_Click" Background="#151515" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="16" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8"><TextBlock Text="♞" FontFamily="Segoe UI Symbol" Foreground="#b7b7b7" FontSize="25" /><TextBlock Text="Puzzles" Foreground="#eeeeee" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Sharpen your tactics." Foreground="#858585" FontSize="12" /></StackPanel>
          </Button>
            <Button Grid.Column="1" Click="Learn_Click" Background="#151515" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8"><TextBlock Text="▰ ▰" Foreground="#b7b7b7" FontSize="20" /><TextBlock Text="Learn" Foreground="#eeeeee" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Build a stronger foundation." Foreground="#858585" FontSize="12" /></StackPanel>
          </Button>
        </Grid>

        <Border Background="#151515" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="16">
          <Grid>
            <StackPanel Spacing="6"><TextBlock Text="Play in person" Foreground="#eeeeee" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Set up a game across the board." Foreground="#858585" FontSize="12" /></StackPanel>
            <Button Click="InPerson_Click" Content="Set up game" Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="BotsContent" Grid.Column="1" Margin="28,0,28,0" HorizontalAlignment="Center" MaxWidth="760" Visibility="Collapsed">
      <Grid Width="700" Height="700" MaxWidth="{Binding ActualWidth, ElementName=BoardHost}" MaxHeight="{Binding ActualHeight, ElementName=BoardHost}" x:Name="BoardHost" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♜" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♞" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="2" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♝" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="3" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♛" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="4" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♚" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="5" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♝" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="6" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♞" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="0" Grid.Column="7" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♜" Style="{StaticResource BlackPieceStyle}" /></Border>
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="1" Grid.Column="3" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="1" Grid.Column="4" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="1" Grid.Column="5" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="1" Grid.Column="6" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border><Border Grid.Row="1" Grid.Column="7" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♟" Style="{StaticResource BlackPieceStyle}" /></Border>
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="2" Grid.Column="2" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="2" Grid.Column="3" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="2" Grid.Column="4" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="2" Grid.Column="5" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="2" Grid.Column="6" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="2" Grid.Column="7" Style="{StaticResource DarkSquareStyle}" />
        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="3" Grid.Column="1" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="3" Grid.Column="2" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="3" Grid.Column="3" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="3" Grid.Column="4" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="3" Grid.Column="5" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="3" Grid.Column="6" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="3" Grid.Column="7" Style="{StaticResource LightSquareStyle}" />
        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="4" Grid.Column="1" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="4" Grid.Column="2" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="4" Grid.Column="3" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="4" Grid.Column="4" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="4" Grid.Column="5" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="4" Grid.Column="6" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="4" Grid.Column="7" Style="{StaticResource DarkSquareStyle}" />
        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="5" Grid.Column="1" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="5" Grid.Column="2" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="5" Grid.Column="3" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="5" Grid.Column="4" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="5" Grid.Column="5" Style="{StaticResource LightSquareStyle}" /><Border Grid.Row="5" Grid.Column="6" Style="{StaticResource DarkSquareStyle}" /><Border Grid.Row="5" Grid.Column="7" Style="{StaticResource LightSquareStyle}" />
        <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="1" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="2" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="3" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="4" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="5" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="6" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="6" Grid.Column="7" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♙" Style="{StaticResource WhitePieceStyle}" /></Border>
        <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♖" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="1" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♘" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="2" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♗" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="3" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♕" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="4" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♔" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="5" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♗" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="6" Style="{StaticResource DarkSquareStyle}"><TextBlock Text="♘" Style="{StaticResource WhitePieceStyle}" /></Border><Border Grid.Row="7" Grid.Column="7" Style="{StaticResource LightSquareStyle}"><TextBlock Text="♖" Style="{StaticResource WhitePieceStyle}" /></Border>
      </Grid>
    </Grid>

    <Border x:Name="EngineContent" Grid.Column="2" Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="32" Height="32" CornerRadius="8" Background="#86c440"><TextBlock Text="01" Foreground="#050505" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Text="Engine" Foreground="#f5f5f5" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Computer opponent" Foreground="#858585" FontSize="11" /></StackPanel><Ellipse Width="8" Height="8" Fill="#86c440" VerticalAlignment="Center" HorizontalAlignment="Right" /></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18">
          <TextBlock Text="Ready when you are" Foreground="#dddddd" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="A clean local board for testing the next move." Foreground="#8e8e8e" FontSize="13" TextWrapping="Wrap" />
          <Border Background="#1b1b1b" CornerRadius="8" Padding="12"><StackPanel Spacing="8"><TextBlock Text="ENGINE PROFILE" Foreground="#6f6f6f" FontSize="10" FontWeight="Bold" /><Grid><TextBlock Text="Depth" Foreground="#a7a7a7" /><TextBlock Text="—" HorizontalAlignment="Right" Foreground="#eeeeee" /><TextBlock Text="Mode" Foreground="#a7a7a7" Margin="0,26,0,0" /><TextBlock Text="Standby" HorizontalAlignment="Right" Foreground="#86c440" Margin="0,26,0,0" /></Grid></StackPanel></Border>
        </StackPanel>
        <Button Grid.Row="2" Content="New game" Height="52" Background="#86c440" Foreground="#071006" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Center" CornerRadius="8" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="LearnContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="28,16,28,18" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="16">
        <Grid>
          <StackPanel Spacing="4"><TextBlock Text="Learn" Foreground="#f2f2f2" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Master the game step-by-step or dive into a focused course." Foreground="#8e8e8e" FontSize="14" /></StackPanel>
        </Grid>
        <Border Background="#171b17" BorderBrush="#303a30" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnSpacing="24">
            <StackPanel Spacing="6"><TextBlock Text="CURRENT COURSE" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="FoundationsResumeTitle" Text="Start with Foundations" Foreground="#eeeeee" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="FoundationsResumeDetail" Text="Welcome to Chess  •  Lesson 1 of 7" Foreground="#999f99" FontSize="12" /><TextBlock x:Name="FoundationsProgressText" Text="Not started  •  0 of 7 lessons" Foreground="#86c440" FontSize="12" /></StackPanel>
            <Button x:Name="FoundationsResumeAction" Grid.Column="1" Content="Start lesson" Click="Foundations_Click" Style="{StaticResource GreenActionButtonStyle}" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Grid ColumnSpacing="18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
          <Border Background="#121412" BorderBrush="#292f29" BorderThickness="1" CornerRadius="9" Padding="18">
            <StackPanel Spacing="14">
              <StackPanel Spacing="3"><TextBlock Text="SUGGESTED JOURNEY" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="A route through sections of your courses and libraries." Foreground="#858b85" FontSize="12" TextWrapping="Wrap" /></StackPanel>
              <StackPanel Spacing="0">
                <Button Click="Foundations_Click" Background="Transparent" BorderBrush="Transparent" Padding="0,8" HorizontalContentAlignment="Stretch"><Grid><Border x:Name="FoundationsJourneyMarker" Width="22" Height="22" CornerRadius="11" Background="#303630" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="1" Foreground="#d7e6cf" FontWeight="Bold" Width="22" Height="22" TextAlignment="Center" LineHeight="22" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" /></Border><StackPanel Margin="36,0,0,0"><TextBlock Text="Foundations" Foreground="#eeeeee" FontWeight="SemiBold" /><TextBlock x:Name="FoundationsJourneyStatus" Text="Not started  •  0 of 7 lessons" Foreground="#a7b89d" FontSize="11" /></StackPanel></Grid></Button>
                <Border Padding="0,8"><Grid><Border Width="22" Height="22" CornerRadius="11" Background="#86c440" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="2" Foreground="#071006" FontWeight="Bold" Width="22" Height="22" TextAlignment="Center" LineHeight="22" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" /></Border><StackPanel Margin="36,0,0,0"><TextBlock Text="Core principles" Foreground="#eeeeee" FontWeight="SemiBold" /><TextBlock Text="In progress  •  4 of 8 lessons" Foreground="#a7b89d" FontSize="11" /></StackPanel></Grid></Border>
                <Border Padding="0,8"><Grid><Border Width="22" Height="22" CornerRadius="11" Background="#303630" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="3" Foreground="#8d958d" FontWeight="Bold" Width="22" Height="22" TextAlignment="Center" LineHeight="22" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" /></Border><StackPanel Margin="36,0,0,0"><TextBlock Text="Basic tactics" Foreground="#a0a5a0" FontWeight="SemiBold" /><TextBlock Text="7 lessons" Foreground="#686f68" FontSize="11" /></StackPanel></Grid></Border>
                <Border Padding="0,8"><Grid><Border Width="22" Height="22" CornerRadius="11" Background="#303630" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="4" Foreground="#8d958d" FontWeight="Bold" Width="22" Height="22" TextAlignment="Center" LineHeight="22" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" /></Border><StackPanel Margin="36,0,0,0"><TextBlock Text="Endgame essentials" Foreground="#a0a5a0" FontWeight="SemiBold" /><TextBlock Text="6 lessons" Foreground="#686f68" FontSize="11" /></StackPanel></Grid></Border>
                <Border Padding="0,8"><Grid><Border Width="22" Height="22" CornerRadius="11" Background="#303630" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="5" Foreground="#8d958d" FontWeight="Bold" Width="22" Height="22" TextAlignment="Center" LineHeight="22" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" /></Border><StackPanel Margin="36,0,0,0"><TextBlock Text="Strategic masterclass" Foreground="#a0a5a0" FontWeight="SemiBold" /><TextBlock Text="8 lessons" Foreground="#686f68" FontSize="11" /></StackPanel></Grid></Border>
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="STANDALONE COURSES &amp; LIBRARIES" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" />
            <Grid ColumnSpacing="10" RowSpacing="10">
              <Grid.Resources><Style TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style></Grid.Resources>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <Button Click="Foundations_Click" Background="#151715" BorderBrush="#2d352d" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel Spacing="7"><TextBlock Text="COURSE  •  FOUNDATIONS" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Chess basics" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Rules, pieces, notation and special moves." Foreground="#858b85" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="7 lessons  •  Beginner" Foreground="#666e66" FontSize="10" /></StackPanel></Button>
              <Button Grid.Column="1" Click="BlankLearnOption_Click" Background="#151715" BorderBrush="#2d352d" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel Spacing="7"><TextBlock Text="COURSE  •  PRINCIPLES" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Chess principles" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Build habits around the center, development and king safety." Foreground="#858b85" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="10 lessons  •  Beginner" Foreground="#666e66" FontSize="10" /></StackPanel></Button>
              <Button Grid.Row="1" Click="OpeningLibrary_Click" Background="#151715" BorderBrush="#2d352d" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel Spacing="7"><TextBlock Text="LIBRARY  •  OPENINGS" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Opening library" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="A growing database for exploring openings, plans and deep study." Foreground="#858b85" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="14 lessons  •  Beginner-Advanced" Foreground="#666e66" FontSize="10" /></StackPanel></Button>
              <Button Grid.Row="1" Grid.Column="1" Click="BlankLearnOption_Click" Background="#151715" BorderBrush="#2d352d" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel Spacing="7"><TextBlock Text="COURSE  •  TACTICS" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Mating strategies" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Recognize patterns and attack the castled king." Foreground="#858b85" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="9 lessons  •  Beginner-Advanced" Foreground="#666e66" FontSize="10" /></StackPanel></Button>
              <Button Grid.Row="2" Click="BlankLearnOption_Click" Background="#151715" BorderBrush="#2d352d" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel Spacing="7"><TextBlock Text="COURSE  •  POSITIONAL PLAY" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Midgame strategy" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Pawn structures, piece placement and prophylaxis." Foreground="#858b85" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="11 lessons  •  Intermediate-Advanced" Foreground="#666e66" FontSize="10" /></StackPanel></Button>
              <Button Grid.Row="2" Grid.Column="1" Click="BlankLearnOption_Click" Background="#151715" BorderBrush="#2d352d" BorderThickness="1" CornerRadius="8" Padding="14" HorizontalContentAlignment="Stretch"><StackPanel Spacing="7"><TextBlock Text="COURSE  •  ENDGAMES" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Endgame mastery" Foreground="#eeeeee" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Convert wins and save drawn positions." Foreground="#858b85" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="13 lessons  •  Intermediate-Advanced" Foreground="#666e66" FontSize="10" /></StackPanel></Button>
            </Grid>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="FoundationsLessonContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="28,16,28,18" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14"><StackPanel Spacing="4"><TextBlock Text="Foundations" Foreground="#f2f2f2" FontSize="29" FontWeight="SemiBold" /><TextBlock x:Name="FoundationsLessonStepText" Text="Lesson 1 of 7" Foreground="#8e8e8e" FontSize="14" /></StackPanel><Button Content="Back to Learn" Click="BackToLearn_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
      <Grid Grid.Row="1" ColumnSpacing="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1*" MinWidth="270" /></Grid.ColumnDefinitions>
        <Border Background="#121212" BorderBrush="#292929" BorderThickness="1" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="FoundationsBoardGrid" Width="640" Height="640" />
          </Viewbox>
        </Border>
        <Border Grid.Column="1" Background="#111111" BorderBrush="#282828" BorderThickness="1" CornerRadius="12" Padding="18" VerticalAlignment="Stretch">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="34" Height="34" CornerRadius="8" Background="#86c440"><TextBlock Text="01" Foreground="#050505" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Text="Engine" Foreground="#f5f5f5" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Foundations guide" Foreground="#858585" FontSize="11" /></StackPanel></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18"><TextBlock Text="Let’s begin." Foreground="#dddddd" FontSize="23" FontWeight="SemiBold" /><Border Background="#1b1b1b" BorderBrush="#2b332b" BorderThickness="1" CornerRadius="8" Padding="14"><TextBlock x:Name="FoundationsLessonMessage" Text="Welcome to Chess!" Foreground="#eeeeee" FontSize="17" TextWrapping="Wrap" /></Border><TextBlock Text="The first lesson starts with the board itself." Foreground="#8e8e8e" FontSize="13" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Grid.Row="2" Spacing="10"><StackPanel x:Name="FoundationsPromotionPanel" Visibility="Collapsed" Spacing="6"><TextBlock Text="PROMOTE TO" Foreground="#6f6f6f" FontSize="10" FontWeight="Bold" /><Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Content="Q" Tag="Queen" Click="PromotionChoice_Click" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" /><Button Grid.Column="1" Content="R" Tag="Rook" Click="PromotionChoice_Click" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" /><Button Grid.Column="2" Content="B" Tag="Bishop" Click="PromotionChoice_Click" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" /><Button Grid.Column="3" Content="N" Tag="Knight" Click="PromotionChoice_Click" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" /></Grid></StackPanel><Button x:Name="FoundationsNextButton" Content="Next" Click="FoundationsNext_Click" Style="{StaticResource GreenActionButtonStyle}" Height="52" /></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <ScrollViewer x:Name="OpeningLibraryContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="28,16,28,18" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="16">
        <Grid><StackPanel Spacing="4"><TextBlock Text="Opening Library" Foreground="#f2f2f2" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Choose a family of openings to begin a focused course." Foreground="#8e8e8e" FontSize="14" /></StackPanel><Button Content="Back to Learn" Click="BackToLearn_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        <StackPanel x:Name="OpeningCategoryPanel" Spacing="10" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="OpeningListContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="28,16,28,18" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="16">
        <Grid><StackPanel Spacing="4"><TextBlock x:Name="OpeningListTitle" Text="Openings" Foreground="#f2f2f2" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Select an opening to start learning." Foreground="#8e8e8e" FontSize="14" /></StackPanel><Button Content="Back to Library" Click="BackToOpeningLibrary_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        <StackPanel x:Name="OpeningListPanel" Spacing="10" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="OpeningLessonContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="28,16,28,18" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="16">
        <Grid><StackPanel Spacing="4"><TextBlock x:Name="OpeningLessonTitle" Text="Opening" Foreground="#f2f2f2" FontSize="29" FontWeight="SemiBold" /><TextBlock x:Name="OpeningLessonCategory" Text="Opening Library" Foreground="#8e8e8e" FontSize="14" /></StackPanel><Button Content="Back to Openings" Click="BackToOpeningList_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
        <Border Background="#121412" BorderBrush="#292f29" BorderThickness="1" CornerRadius="9" Padding="22"><StackPanel Spacing="10"><TextBlock Text="START LEARNING" Foreground="#86c440" FontSize="10" FontWeight="Bold" /><TextBlock Text="Your first lesson is ready." Foreground="#eeeeee" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="This opening course will introduce the key ideas, common plans, and practical positions to study." Foreground="#858b85" FontSize="13" TextWrapping="Wrap" /><Button Content="Begin lesson" Style="{StaticResource GreenActionButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="EmptyMenuContent" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />

    <Grid x:Name="AccountOverlay" Grid.ColumnSpan="3" Background="#FF080908" Visibility="Collapsed">
      <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.16">
        <Border Background="#101610" />
        <TextBlock Text="♟        ♞        ♜" FontFamily="Segoe UI Symbol" FontSize="170" Foreground="#b8da84" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <Border Width="520" Background="#F2181B18" BorderBrush="#3D493D" BorderThickness="1" CornerRadius="14" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="20">
          <Grid>
            <StackPanel Spacing="5"><TextBlock Text="Your Chess account" Foreground="#ffffff" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Keep your progress, games and preferences together." Foreground="#a0a79f" FontSize="13" TextWrapping="Wrap" /><TextBlock Text="Saved locally on this computer" Foreground="#697169" FontSize="12" /></StackPanel>
            <Button Content="×" Click="CloseAccount_Click" Style="{StaticResource DialogCloseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" />
          </Grid>
          <Grid x:Name="AccountTabs" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="SignUpTab" Grid.Column="0" Content="Sign Up" Click="ShowSignUp_Click" Style="{StaticResource AccountTabStyle}" Foreground="#ffffff" />
            <Button x:Name="LogInTab" Grid.Column="1" Content="Log In" Click="ShowLogIn_Click" Style="{StaticResource AccountTabStyle}" Foreground="#86c440" />
          </Grid>
          <StackPanel x:Name="SignUpFields" Spacing="12">
            <TextBlock Text="Create a local account" Foreground="#d9ded8" FontSize="16" FontWeight="SemiBold" />
            <TextBox x:Name="SignUpUsername" PlaceholderText="Username" Style="{StaticResource AccountTextBoxStyle}" />
            <PasswordBox x:Name="SignUpPassword" PlaceholderText="Password" Style="{StaticResource AccountPasswordBoxStyle}" />
            <PasswordBox x:Name="SignUpConfirmation" PlaceholderText="Confirm password" Style="{StaticResource AccountPasswordBoxStyle}" />
            <Button Content="Create account" Click="CreateAccount_Click" Style="{StaticResource GreenActionButtonStyle}" />
          </StackPanel>
          <StackPanel x:Name="LogInFields" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="Welcome back" Foreground="#d9ded8" FontSize="16" FontWeight="SemiBold" />
            <TextBox x:Name="LogInUsername" PlaceholderText="Username" Style="{StaticResource AccountTextBoxStyle}" />
            <PasswordBox x:Name="LogInPassword" PlaceholderText="Password" Style="{StaticResource AccountPasswordBoxStyle}" />
            <Button Content="Log in" Click="LogIn_Click" Style="{StaticResource GreenActionButtonStyle}" />
            <Button Content="Switch to an existing account" Click="ShowLoginAccountList_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Center" />
            <StackPanel x:Name="LoginAccountList" Visibility="Collapsed" Spacing="2" />
            <Button Content="Don't have an account? Create one!" Click="CreateAccountPrompt_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="AccountErrorText" Foreground="#ef8a8a" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

</Window>